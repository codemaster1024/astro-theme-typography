---
// No server-side logic needed for the modal component
---

<div id="search-modal" class="search-modal" role="dialog" aria-hidden="true" aria-labelledby="search-title">
  <div class="search-overlay" data-search-close></div>
  <div class="search-container">
    <div class="search-header">
      <div class="search-input-container">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input 
          id="search-input"
          type="text" 
          placeholder="搜索博客内容..." 
          aria-label="搜索博客内容"
          autocomplete="off"
          spellcheck="false"
        />
        <button class="search-close" data-search-close aria-label="关闭搜索">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="search-shortcuts">
        <kbd>↑</kbd><kbd>↓</kbd> 导航
        <kbd>↵</kbd> 打开
        <kbd>ESC</kbd> 关闭
      </div>
    </div>
    
    <div class="search-content">
      <div id="search-loading" class="search-loading" style="display: none;">
        <div class="loading-spinner"></div>
        <span>搜索中...</span>
      </div>
      
      <div id="search-empty" class="search-empty">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <h3>开始搜索</h3>
        <p>输入关键词搜索博客文章</p>
      </div>
      
      <div id="search-no-results" class="search-no-results" style="display: none;">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="m21 21-4.35-4.35"></path>
          <circle cx="11" cy="11" r="8"></circle>
        </svg>
        <h3>未找到结果</h3>
        <p>尝试使用不同的关键词</p>
      </div>
      
      <div id="search-results" class="search-results" style="display: none;"></div>
    </div>
  </div>
</div>

<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 1rem 1rem;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }
  
  .search-modal[aria-hidden="false"] {
    display: flex;
    animation: fadeIn 0.2s ease-out;
  }
  
  .search-overlay {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }
  
  .search-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    max-height: 70vh;
    background: var(--bg-color, #fff);
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-color, #e2e8f0);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: slideUp 0.3s ease-out;
  }
  
  .search-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
    background: var(--bg-color, #fff);
  }
  
  .search-input-container {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }
  
  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-muted, #64748b);
    pointer-events: none;
  }
  
  #search-input {
    width: 100%;
    height: 3rem;
    padding: 0 3rem 0 3.5rem;
    border: 2px solid var(--border-color, #e2e8f0);
    border-radius: 8px;
    background: var(--input-bg, #f8fafc);
    color: var(--text-color, #1e293b);
    font-size: 1rem;
    outline: none;
    transition: all 0.2s;
  }
  
  #search-input:focus {
    border-color: var(--primary-color, #3b82f6);
    box-shadow: 0 0 0 3px var(--primary-color-alpha, rgba(59, 130, 246, 0.1));
  }
  
  .search-close {
    position: absolute;
    right: 1rem;
    width: 2rem;
    height: 2rem;
    border: none;
    background: none;
    color: var(--text-muted, #64748b);
    cursor: pointer;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  
  .search-close:hover {
    background: var(--hover-bg, #f1f5f9);
    color: var(--text-color, #1e293b);
  }
  
  .search-shortcuts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted, #64748b);
  }
  
  .search-shortcuts kbd {
    background: var(--kbd-bg, #f1f5f9);
    color: var(--text-color, #1e293b);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 500;
    border: 1px solid var(--border-color, #e2e8f0);
  }
  
  .search-content {
    flex: 1;
    overflow-y: auto;
    max-height: calc(70vh - 120px);
  }
  
  .search-loading,
  .search-empty,
  .search-no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    text-align: center;
    color: var(--text-muted, #64748b);
  }
  
  .search-loading svg,
  .search-empty svg,
  .search-no-results svg {
    margin-bottom: 1rem;
    opacity: 0.6;
  }
  
  .search-loading h3,
  .search-empty h3,
  .search-no-results h3 {
    margin: 0 0 0.5rem 0;
    color: var(--text-color, #1e293b);
    font-weight: 600;
  }
  
  .search-loading p,
  .search-empty p,
  .search-no-results p {
    margin: 0;
    font-size: 0.875rem;
  }
  
  .loading-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--border-color, #e2e8f0);
    border-top-color: var(--primary-color, #3b82f6);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 0.5rem;
  }
  
  .search-results {
    padding: 0.75rem 0;
  }
  
  .search-modal .search-results .search-result {
    display: block !important;
    padding: 1.25rem 1.5rem !important;
    width: 100% !important;
    text-align: left !important;
    cursor: pointer !important;
    text-decoration: none !important;
    color: inherit !important;
    transition: all 0.2s ease !important;
    border: 2px solid #e2e8f0 !important;
    border-radius: 12px !important;
    margin-bottom: 16px !important;
    background: #ffffff !important;
    box-shadow: 0 2px 8px 0 rgba(0, 0, 0, 0.12) !important;
  }
  
  .search-modal .search-results .search-result:last-child {
    margin-bottom: 0 !important;
  }
  
  /* 防止全局链接样式影响搜索结果 */
  .search-result.not-underline-hover {
    text-decoration: none !important;
  }
  
  .search-result.not-underline-hover:hover {
    background: var(--hover-bg, #f8fafc) !important;
    color: var(--text-color, #1e293b) !important;
    text-decoration: none !important;
  }
  
  .search-modal .search-results .search-result:hover,
  .search-modal .search-results .search-result.highlighted {
    background: #f8fafc !important;
    border-color: #3b82f6 !important;
    box-shadow: 0 6px 24px 0 rgba(59, 130, 246, 0.3) !important;
    transform: translateY(-3px) !important;
    color: inherit !important;
  }
  
  .search-result:hover .search-result-title,
  .search-result.highlighted .search-result-title {
    color: var(--text-color, #1e293b) !important;
  }
  
  .search-result:hover .search-result-meta,
  .search-result.highlighted .search-result-meta {
    color: var(--text-muted, #64748b) !important;
  }
  
  .search-result:hover .search-result-content,
  .search-result.highlighted .search-result-content {
    color: var(--text-muted, #64748b) !important;
  }
  
  /* 覆盖全局链接样式 */
  .search-modal .search-result:hover {
    background: #f8fafc !important;
    border-color: #3b82f6 !important;
    color: #1e293b !important;
    text-decoration: none !important;
  }
  
  .search-modal .search-result.highlighted {
    background: #f8fafc !important;
    border-color: #3b82f6 !important;
    color: #1e293b !important;
    text-decoration: none !important;
  }
  
  .search-result-title {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--text-color, #1e293b);
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .search-result-title::before {
    content: "📄";
    font-size: 0.9rem;
    opacity: 0.7;
  }
  
  .search-result-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted, #64748b);
    font-weight: 500;
  }
  
  .search-result-date {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .search-result-date::before {
    content: "📅";
    font-size: 0.7rem;
    opacity: 0.6;
  }
  
  .search-result-categories {
    display: flex;
    gap: 0.5rem;
  }
  
  .search-result-category {
    background: var(--tag-bg, #e0f2fe);
    color: var(--tag-color, #0369a1);
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid var(--tag-border, #bae6fd);
  }
  
  .search-result-content {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted, #64748b);
    margin-top: 0.75rem;
    padding: 0.75rem;
    background: var(--content-bg, #f8fafc);
    border-radius: 0.5rem;
    border-left: 3px solid var(--accent-color, #e2e8f0);
  }
  
  .search-highlight {
    background: var(--highlight-bg, #fef3c7);
    color: var(--highlight-color, #92400e);
    padding: 0.125rem 0.25rem;
    border-radius: 3px;
    font-weight: 500;
  }

  /* Dark mode support */
  :global(.dark) .search-modal .search-results .search-result {
    background: #1e293b !important;
    border-color: #334155 !important;
    color: #f1f5f9 !important;
    box-shadow: 0 2px 8px 0 rgba(0, 0, 0, 0.3) !important;
  }
  
  :global(.dark) .search-container {
    --bg-color: #1e293b;
    --border-color: #334155;
    --text-color: #f1f5f9;
    --text-muted: #94a3b8;
    --input-bg: #334155;
    --hover-bg: #2d3748;
    --kbd-bg: #334155;
    --tag-bg: #1e3a8a;
    --tag-color: #93c5fd;
    --tag-border: #1e40af;
    --content-bg: #334155;
    --accent-color: #475569;
    --result-bg: #1e293b;
    --highlight-bg: #451a03;
    --highlight-color: #fbbf24;
    --primary-color: #60a5fa;
    --primary-color-alpha: rgba(96, 165, 250, 0.1);
  }
  
  /* 确保深色模式下悬停时文字可见 */
  :global(.dark) .search-result:hover .search-result-title,
  :global(.dark) .search-result.highlighted .search-result-title {
    color: var(--text-color, #f1f5f9) !important;
  }
  
  :global(.dark) .search-result:hover .search-result-meta,
  :global(.dark) .search-result.highlighted .search-result-meta {
    color: var(--text-muted, #94a3b8) !important;
  }
  
  :global(.dark) .search-result:hover .search-result-content,
  :global(.dark) .search-result.highlighted .search-result-content {
    color: var(--text-muted, #94a3b8) !important;
  }
  
  /* 深色模式下覆盖全局链接样式 */
  :global(.dark) .search-modal .search-results .search-result:hover {
    background: #2d3748 !important;
    border-color: #60a5fa !important;
    box-shadow: 0 6px 24px 0 rgba(96, 165, 250, 0.4) !important;
    color: #f1f5f9 !important;
    text-decoration: none !important;
    transform: translateY(-3px) !important;
  }
  
  :global(.dark) .search-modal .search-results .search-result.highlighted {
    background: #2d3748 !important;
    border-color: #60a5fa !important;
    box-shadow: 0 6px 24px 0 rgba(96, 165, 250, 0.4) !important;
    color: #f1f5f9 !important;
    text-decoration: none !important;
    transform: translateY(-3px) !important;
  }
  
  /* 深色模式下防止全局链接样式影响 */
  :global(.dark) .search-result.not-underline-hover:hover {
    background: var(--hover-bg, #2d3748) !important;
    color: var(--text-color, #f1f5f9) !important;
    text-decoration: none !important;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  
  /* Mobile responsive */
  @media (max-width: 640px) {
    .search-modal {
      padding: 5vh 1rem 1rem;
    }
    
    .search-container {
      max-height: 80vh;
    }
    
    .search-header {
      padding: 1rem;
    }
    
    .search-shortcuts {
      font-size: 0.7rem;
    }
    
    .search-result {
      padding: 0.875rem 1rem;
    }
  }
</style>